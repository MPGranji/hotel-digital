# Copy this file to backend/.env. Never commit the real connection string.
HOTEL_DATABASE_CONNECTION_STRING=Server=tcp:<server>.database.windows.net,1433;Initial Catalog=<database>;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
HOTEL_CORS_ORIGIN=http://localhost:3000
HOTEL_API_PORT=5080
